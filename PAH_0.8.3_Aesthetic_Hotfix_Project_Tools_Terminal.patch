diff --git a/pah/web/static/pah.css b/pah/web/static/pah.css
index b096cd2..67a58d2 100644
--- a/pah/web/static/pah.css
+++ b/pah/web/static/pah.css
@@ -471,3 +471,33 @@ body.pane-resizing-column,
 body.pane-resizing-column * { cursor: col-resize !important; user-select: none !important; }
 body.pane-resizing-row,
 body.pane-resizing-row * { cursor: row-resize !important; user-select: none !important; }
+
+/* PAH 0.8.3 aesthetic hotfix: compact Project Tools header and true terminal clipping */
+.analysis-heading {
+  flex-wrap: nowrap;
+  overflow: hidden;
+}
+.analysis-heading > div:first-child {
+  flex: 1 1 auto;
+  min-width: 0;
+  flex-wrap: nowrap;
+  overflow: hidden;
+  white-space: nowrap;
+}
+.analysis-heading > div:first-child > span:first-child { flex: 0 0 auto; }
+.analysis-heading .badge {
+  flex: 0 1 auto;
+  min-width: 0;
+  max-width: 68px;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+.analysis-heading-actions {
+  flex: 0 0 auto;
+  flex-wrap: nowrap;
+}
+
+.terminal-panel.collapsed { overflow: hidden; }
+.terminal-panel.collapsed .terminal-output,
+.terminal-panel.collapsed .terminal-input-row { display: none; }
