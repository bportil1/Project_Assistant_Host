diff --git a/pah/web/static/pah-identity.css b/pah/web/static/pah-identity.css
new file mode 100644
index 0000000..3030372
--- /dev/null
+++ b/pah/web/static/pah-identity.css
@@ -0,0 +1,398 @@
+/*
+ * PAH Visual Identity — host shell override
+ *
+ * Load AFTER the existing pah.css. This file deliberately changes visual
+ * presentation only. Existing IDs, layout behavior, JS contracts, and module
+ * routing remain untouched.
+ */
+
+:root {
+  color-scheme: light;
+
+  /* PAH signature palette: evolved from Bryan's existing blue/sky/teal tools. */
+  --pah-navy-950: #05244c;
+  --pah-navy-900: #082f63;
+  --pah-navy-800: #0d457e;
+  --pah-blue-700: #17679c;
+  --pah-blue-600: #247eb0;
+  --pah-sky-300: #8ecae6;
+  --pah-sky-200: #b8dfef;
+  --pah-teal-600: #008f86;
+  --pah-teal-500: #00a69a;
+  --pah-green-500: #62b96a;
+
+  /* Technical application surfaces. */
+  --pah-page: #e9eef2;
+  --pah-surface: #ffffff;
+  --pah-surface-2: #f4f7f9;
+  --pah-surface-3: #eaf1f5;
+  --pah-border: #bdc8d1;
+  --pah-border-strong: #8897a3;
+  --pah-text: #17212b;
+  --pah-muted: #64717d;
+  --pah-muted-2: #7d8994;
+
+  /* Dark surfaces remain semantic: source code + terminal. */
+  --pah-editor: #15191f;
+  --pah-editor-2: #1b2129;
+  --pah-editor-border: #303946;
+  --pah-editor-text: #d7dee8;
+  --pah-terminal: #0f1419;
+
+  /* Status. */
+  --pah-danger: #a83a3a;
+  --pah-warning: #966d12;
+  --pah-success: #397b42;
+
+  /* Geometry: restrained desktop-tool feel. */
+  --pah-radius-xs: 2px;
+  --pah-radius-sm: 3px;
+  --pah-radius-md: 5px;
+  --pah-shadow-sm: 0 1px 2px rgb(5 36 76 / 0.08);
+  --pah-shadow-md: 0 5px 18px rgb(5 36 76 / 0.12);
+
+  /* Map legacy PAH variables so existing selectors inherit the new identity. */
+  --bg: var(--pah-page);
+  --panel: var(--pah-surface);
+  --panel-2: var(--pah-surface-2);
+  --border: var(--pah-border);
+  --text: var(--pah-text);
+  --muted: var(--pah-muted);
+  --accent: var(--pah-blue-600);
+  --danger: var(--pah-danger);
+}
+
+html,
+body {
+  background: var(--pah-page);
+  color: var(--pah-text);
+  font-family: "Segoe UI", "Noto Sans", Ubuntu, system-ui, -apple-system, sans-serif;
+}
+
+/* ----- Application frame ------------------------------------------------ */
+
+.topbar {
+  min-height: 48px;
+  gap: 12px;
+  padding: 6px 10px;
+  background: linear-gradient(180deg, var(--pah-navy-900), var(--pah-navy-950));
+  border-bottom: 2px solid var(--pah-sky-300);
+  color: #fff;
+  box-shadow: 0 1px 0 rgb(255 255 255 / 0.08) inset;
+}
+
+.brand {
+  color: #fff;
+  font-size: 17px;
+  font-style: italic;
+  font-weight: 800;
+  letter-spacing: 0.025em;
+  text-transform: uppercase;
+}
+
+.brand span {
+  color: rgb(255 255 255 / 0.72);
+  font-size: 11px;
+  font-style: normal;
+  font-weight: 600;
+  letter-spacing: 0.055em;
+  text-transform: uppercase;
+}
+
+.workspace-bar input,
+.workspace-bar select {
+  min-height: 31px;
+  background: rgb(255 255 255 / 0.98);
+  color: var(--pah-text);
+  border: 1px solid rgb(255 255 255 / 0.46);
+  border-radius: var(--pah-radius-sm);
+  box-shadow: 0 1px 0 rgb(0 0 0 / 0.08) inset;
+}
+
+.workspace-bar input:focus,
+.workspace-bar select:focus {
+  outline: 2px solid rgb(142 202 230 / 0.38);
+  outline-offset: 1px;
+  border-color: var(--pah-sky-300);
+}
+
+/* Navigation is navigation, not a row of floating SaaS pills. */
+.mode-nav {
+  align-self: stretch;
+  gap: 0;
+}
+
+.mode-button {
+  position: relative;
+  min-height: 100%;
+  padding: 5px 10px 4px;
+  background: transparent;
+  color: rgb(255 255 255 / 0.72);
+  border: 0;
+  border-radius: 0;
+  font-size: 10px;
+  font-weight: 750;
+  letter-spacing: 0.045em;
+  text-transform: uppercase;
+}
+
+.mode-button:hover {
+  background: rgb(255 255 255 / 0.07);
+  color: #fff;
+}
+
+.mode-button.active {
+  background: rgb(255 255 255 / 0.09);
+  color: #fff;
+  border: 0;
+}
+
+.mode-button.active::before {
+  content: "";
+  position: absolute;
+  left: 9px;
+  right: 9px;
+  bottom: 0;
+  height: 3px;
+  background: var(--pah-sky-300);
+}
+
+.mode-button.detached {
+  color: #c8edcd;
+  border: 0;
+}
+
+.mode-button.detached::after {
+  color: #b6e7be;
+}
+
+/* ----- Shared controls -------------------------------------------------- */
+
+button,
+.button-link {
+  min-height: 29px;
+  padding: 4px 9px;
+  background: linear-gradient(#ffffff, #e2e8ed);
+  color: var(--pah-text);
+  border: 1px solid var(--pah-border-strong);
+  border-radius: var(--pah-radius-sm);
+  box-shadow: 0 1px 0 rgb(255 255 255 / 0.86) inset;
+  font-weight: 600;
+}
+
+button:hover,
+.button-link:hover {
+  background: #e6f2f8;
+  color: var(--pah-navy-900);
+  border-color: var(--pah-blue-600);
+}
+
+button:active,
+.button-link:active {
+  background: #d9e8f0;
+  box-shadow: 0 1px 2px rgb(5 36 76 / 0.12) inset;
+}
+
+button:focus-visible,
+.button-link:focus-visible,
+input:focus-visible,
+select:focus-visible,
+textarea:focus-visible {
+  outline: 2px solid rgb(36 126 176 / 0.32);
+  outline-offset: 1px;
+}
+
+button:disabled {
+  opacity: 0.5;
+}
+
+button.danger:hover {
+  color: var(--pah-danger);
+  border-color: #ba7777;
+  background: #fff1f1;
+}
+
+input,
+select,
+textarea {
+  background: #fff;
+  color: var(--pah-text);
+  border: 1px solid var(--pah-border-strong);
+  border-radius: var(--pah-radius-sm);
+}
+
+input::placeholder,
+textarea::placeholder {
+  color: #87939d;
+}
+
+/* ----- Shared panel language ------------------------------------------- */
+
+.panel-heading,
+.analysis-heading,
+.terminal-heading,
+.full-tool-status {
+  color: #fff;
+  background: linear-gradient(180deg, var(--pah-navy-800), var(--pah-navy-900));
+  border-color: var(--pah-navy-950);
+}
+
+.panel-heading,
+.analysis-heading,
+.terminal-heading {
+  min-height: 32px;
+  padding: 4px 8px;
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: 0.075em;
+}
+
+.panel-heading button,
+.analysis-heading button,
+.terminal-heading button,
+.full-tool-status button {
+  min-height: 23px;
+  padding: 2px 7px;
+  background: rgb(255 255 255 / 0.10);
+  color: #fff;
+  border-color: rgb(255 255 255 / 0.28);
+  box-shadow: none;
+  font-size: 10px;
+}
+
+.panel-heading button:hover,
+.analysis-heading button:hover,
+.terminal-heading button:hover,
+.full-tool-status button:hover {
+  background: rgb(255 255 255 / 0.18);
+  color: #fff;
+  border-color: rgb(255 255 255 / 0.52);
+}
+
+.section-title {
+  color: var(--pah-navy-900);
+  font-weight: 800;
+  letter-spacing: 0.07em;
+}
+
+.section-title::after {
+  content: "";
+  display: block;
+  width: 32px;
+  height: 2px;
+  margin-top: 4px;
+  background: var(--pah-sky-300);
+}
+
+.section-title-row::after {
+  display: none;
+}
+
+/* Remove template-like pill treatment from ordinary state labels. */
+.badge {
+  min-height: 17px;
+  padding: 1px 5px;
+  border-radius: var(--pah-radius-xs);
+  font-size: 9px;
+  font-weight: 700;
+}
+
+.badge.ready {
+  color: #285d30;
+  border-color: #8cb792;
+  background: #e6f3e8;
+}
+
+.badge.stale {
+  color: #765711;
+  border-color: #c9ae69;
+  background: #fff7dc;
+}
+
+.badge.missing {
+  color: #8a3030;
+  border-color: #cc9292;
+  background: #fff0f0;
+}
+
+.badge.muted {
+  color: var(--pah-muted);
+  background: var(--pah-surface-2);
+}
+
+/* ----- Dialogs and feedback -------------------------------------------- */
+
+dialog {
+  background: var(--pah-surface);
+  color: var(--pah-text);
+  border: 1px solid var(--pah-border-strong);
+  border-radius: var(--pah-radius-md);
+  box-shadow: 0 18px 60px rgb(5 36 76 / 0.28);
+}
+
+dialog::backdrop {
+  background: rgb(5 20 35 / 0.48);
+}
+
+.dialog-heading {
+  margin: -16px -16px 12px;
+  padding: 10px 12px 8px 16px;
+  background: linear-gradient(180deg, var(--pah-navy-800), var(--pah-navy-900));
+  color: #fff;
+  border-bottom: 2px solid var(--pah-sky-300);
+}
+
+.dialog-heading h3 {
+  margin: 0;
+  font-size: 14px;
+  letter-spacing: 0.02em;
+}
+
+.dialog-heading .plain {
+  min-height: 24px;
+  color: #fff;
+  border: 0;
+  background: transparent;
+  box-shadow: none;
+}
+
+.dialog-card label,
+.hint,
+.small-muted,
+.analysis-placeholder {
+  color: var(--pah-muted);
+}
+
+.env-status,
+.analysis-message {
+  background: var(--pah-surface-2);
+  border-color: var(--pah-border);
+  color: var(--pah-muted);
+  border-radius: var(--pah-radius-sm);
+}
+
+.analysis-message.warning {
+  color: #765711;
+  border-color: #d2b770;
+  background: #fff9e6;
+}
+
+.analysis-message.error {
+  color: #8a3030;
+  border-color: #d5a1a1;
+  background: #fff2f2;
+}
+
+.toast {
+  background: var(--pah-navy-950);
+  color: #fff;
+  border: 1px solid var(--pah-sky-300);
+  border-radius: var(--pah-radius-sm);
+  box-shadow: var(--pah-shadow-md);
+}
+
+.toast.error {
+  color: #fff;
+  border-color: #d98989;
+  background: #702f2f;
+}
diff --git a/pah/web/static/pah-tools.css b/pah/web/static/pah-tools.css
