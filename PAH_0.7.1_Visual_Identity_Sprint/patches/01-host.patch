@@ -0,0 +1,232 @@
+/*
+ * PAH Visual Identity — context tools, hosted service frames and data surfaces
+ * Load after pah.css, pah-identity.css and pah-workspace.css.
+ */
+
+/* ----- Context / quick-tool surface ----------------------------------- */
+
+.analysis-panel {
+  border-left-color: var(--pah-border);
+  background: var(--pah-surface);
+}
+
+.analysis-tabs {
+  background: var(--pah-surface-2);
+  border-bottom-color: var(--pah-border);
+}
+
+.analysis-tab {
+  position: relative;
+  min-height: 31px;
+  padding: 5px;
+  background: var(--pah-surface-2);
+  color: var(--pah-muted);
+  border-right: 1px solid var(--pah-border);
+  border-radius: 0;
+  box-shadow: none;
+  font-weight: 700;
+}
+
+.analysis-tab:last-child {
+  border-right: 0;
+}
+
+.analysis-tab:hover {
+  background: #e7f2f8;
+  color: var(--pah-navy-900);
+}
+
+.analysis-tab.active {
+  background: var(--pah-surface);
+  color: var(--pah-navy-900);
+  box-shadow: inset 0 -3px var(--pah-sky-300);
+}
+
+.analysis-body {
+  background: var(--pah-surface);
+}
+
+.analysis-section {
+  padding: 10px;
+  border-bottom-color: #d7e0e6;
+}
+
+.analysis-section:nth-of-type(even) {
+  background: #fbfcfd;
+}
+
+.entity-list {
+  gap: 2px;
+}
+
+.entity-item,
+.analysis-row,
+.result-row {
+  padding: 6px 7px;
+  background: #fff;
+  color: var(--pah-text);
+  border: 1px solid transparent;
+  border-radius: var(--pah-radius-xs);
+}
+
+.entity-list > :nth-child(even),
+.result-row:nth-child(even),
+.analysis-row:nth-child(even) {
+  background: #edf6fb;
+}
+
+button.entity-item,
+button.result-row {
+  box-shadow: none;
+  font-weight: inherit;
+}
+
+button.entity-item:hover,
+button.result-row:hover,
+.analysis-row:hover {
+  background: #dfeff7;
+  color: var(--pah-navy-950);
+  border-color: #9fc5d8;
+}
+
+.entity-item.selected {
+  background: #d6ebf5;
+  color: var(--pah-navy-950);
+  border-color: var(--pah-blue-600);
+  box-shadow: inset 3px 0 var(--pah-blue-600);
+}
+
+.button-link {
+  text-decoration: none;
+}
+
+/* ----- Full hosted modules -------------------------------------------- */
+
+.full-tool-view {
+  background: var(--pah-page);
+}
+
+.full-tool-status {
+  min-height: 34px;
+  padding: 4px 8px;
+  background: linear-gradient(180deg, var(--pah-navy-800), var(--pah-navy-900));
+  color: rgb(255 255 255 / 0.72);
+  border-bottom: 2px solid var(--pah-sky-300);
+}
+
+.full-tool-status strong {
+  color: #fff;
+  font-size: 11px;
+  font-weight: 800;
+  letter-spacing: 0.06em;
+  text-transform: uppercase;
+}
+
+.full-tool-status button[data-tool-detach] {
+  border-color: rgb(255 255 255 / 0.32);
+}
+
+.full-tool-view iframe {
+  background: var(--pah-page);
+}
+
+/* ----- Generic table styling usable by PAH-hosted module adapters ------ */
+
+.pah-data-table,
+[data-pah-table] {
+  width: 100%;
+  border-collapse: collapse;
+  background: #fff;
+  color: var(--pah-text);
+}
+
+.pah-data-table th,
+[data-pah-table] th {
+  padding: 7px 9px;
+  background: var(--pah-navy-900);
+  color: #fff;
+  border: 1px solid var(--pah-navy-950);
+  font-size: 10px;
+  font-weight: 750;
+  letter-spacing: 0.045em;
+  text-align: left;
+  text-transform: uppercase;
+}
+
+.pah-data-table td,
+[data-pah-table] td {
+  padding: 7px 9px;
+  border: 1px solid #d6dfe5;
+}
+
+.pah-data-table tbody tr:nth-child(even),
+[data-pah-table] tbody tr:nth-child(even) {
+  background: #edf6fb;
+}
+
+.pah-data-table tbody tr:hover,
+[data-pah-table] tbody tr:hover {
+  background: #dceef8;
+}
+
+/* ----- Generic module section/control adapters ------------------------- */
+
+.pah-tool-section,
+[data-pah-section] {
+  background: #fff;
+  border: 1px solid var(--pah-border);
+  border-radius: var(--pah-radius-sm);
+  box-shadow: var(--pah-shadow-sm);
+}
+
+.pah-tool-section__heading,
+[data-pah-section-heading] {
+  min-height: 30px;
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 8px;
+  padding: 5px 8px;
+  background: var(--pah-navy-900);
+  color: #fff;
+  border-bottom: 2px solid var(--pah-sky-300);
+  font-size: 10px;
+  font-weight: 800;
+  letter-spacing: 0.07em;
+  text-transform: uppercase;
+}
+
+.pah-tool-nav,
+[data-pah-tool-nav] {
+  display: flex;
+  gap: 0;
+  background: var(--pah-surface-2);
+  border-bottom: 1px solid var(--pah-border);
+}
+
+.pah-tool-nav > a,
+.pah-tool-nav > button,
+[data-pah-tool-nav] > a,
+[data-pah-tool-nav] > button {
+  position: relative;
+  min-height: 32px;
+  padding: 6px 10px;
+  background: transparent;
+  color: var(--pah-muted);
+  border: 0;
+  border-right: 1px solid var(--pah-border);
+  border-radius: 0;
+  box-shadow: none;
+  text-decoration: none;
+  font-size: 10px;
+  font-weight: 750;
+  letter-spacing: 0.04em;
+  text-transform: uppercase;
+}
+
+.pah-tool-nav > .active,
+[data-pah-tool-nav] > .active {
+  background: #fff;
+  color: var(--pah-navy-900);
+  box-shadow: inset 0 -3px var(--pah-sky-300);
+}
